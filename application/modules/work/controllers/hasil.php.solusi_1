									<input type='checkbox' class='form-check-input' value='1' name='g3' ".( (isset($dadet->g3) && $dadet->g3 == 1) ? "checked" : "" ).">
									<label class='form-check-label' for='exampleCheck1'>G3 : GC-MS</label>
								</div>
